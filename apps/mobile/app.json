{
  "expo": {
    "name": "SnapCook",
    "slug": "snapcook",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "snapcook",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
