{
  "expo": {
    "name": "SnapCook",
    "slug": "snapcook",
    "version": "0.0.0",
    "orientation": "portrait",
    "scheme": "snapcook",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.tennant.snapcook"
    },
    "android": {
      "package": "dev.tennant.snapcook"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      [
        "expo-image-picker",
        {
          "cameraPermission": "SnapCook uses the camera to photograph your fridge and cupboards.",
          "photosPermission": "SnapCook reads the photos you choose, to list the food in them."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
