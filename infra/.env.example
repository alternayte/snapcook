# Copy to .env at the repository root. `just up` reads it.

# Required.
POSTGRES_PASSWORD=

# Host address and port that publish the API. The default is reachable from this machine only.
API_BIND=127.0.0.1:3000

# Host address and port that publish Postgres, for the command-line tools on this machine.
PG_BIND=127.0.0.1:54329

# Host directory for the database and uploaded photos.
DATA_DIR=../data

PG_SHARED_BUFFERS=256MB

# Comma-separated browser origins allowed to call the API. Empty allows none.
CORS_ORIGINS=

# Model access. Every model call goes through OpenRouter; model ids are never written in code.
OPENROUTER_API_KEY=
MODEL_VISION=
MODEL_ADAPT=
MODEL_REVIEW=
# An OpenRouter model id, or claude-code/<model> to use the local Claude Code login.
MODEL_WRITE=
MODEL_EMBED=
# Needed only by the command-line tool that draws recipe pictures.
MODEL_IMAGE=

# The command-line tools read this. Use the PG_BIND port and POSTGRES_PASSWORD from above.
DATABASE_URL=

# The address clients use to reach the API, with scheme and no trailing slash.
PUBLIC_URL=
# A long random value that signs sessions. `openssl rand -base64 32` makes one.
AUTH_SECRET=
# Comma-separated URL schemes of the mobile app that may start a sign-in.
APP_SCHEMES=snapcook://
# Comma-separated email addresses. A household created by one of them gets the owner plan,
# and its members can open the recipe review pages at /admin/recipes.
OWNER_EMAILS=

# Optional sign-in providers. A provider is on only when all of its values are set.
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
APPLE_BUNDLE_ID=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
