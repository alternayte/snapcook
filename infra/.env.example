# Copy to .env at the repository root. `just up` reads it.

# Required.
POSTGRES_PASSWORD=

# A domain name turns on HTTPS with an automatic certificate. `:80` serves plain HTTP.
SITE_ADDRESS=:80
HTTP_PORT=80
HTTPS_PORT=443

# Host directory for the database, uploaded photos and certificates.
DATA_DIR=../data

PG_SHARED_BUFFERS=256MB

# Comma-separated browser origins allowed to call the API. Empty allows none.
CORS_ORIGINS=
